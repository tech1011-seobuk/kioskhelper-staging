        <mxCell id="END_as_ES-2" value="A/S 필요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1418;strokeColor=#e07a7a;fontColor=#f2a3a3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="180" width="160" height="60" as="geometry"/></mxCell>
