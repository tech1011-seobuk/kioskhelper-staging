        <mxCell id="e_n3a_0_ES-1" value="동일합니다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8a8d97;fontColor=#d7e632;fontStyle=1;" edge="1" parent="1" source="n3a_ES-1" target="n4a_ES-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_n3a_1_ES-1" value="해결되었습니다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8a8d97;fontColor=#d7e632;fontStyle=1;" edge="1" parent="1" source="n3a_ES-1" target="END_solved_ES-1"><mxGeometry relative="1" as="geometry"/></mxCell>
