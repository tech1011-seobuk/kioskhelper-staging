        <mxCell id="e_n5a_0_ES-1" value="동일합니다" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8a8d97;fontColor=#d7e632;fontStyle=1;" edge="1" parent="1" source="n5a_ES-1" target="END_escalate_ES-1"><mxGeometry relative="1" as="geometry"/></mxCell>
